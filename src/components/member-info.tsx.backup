import { useState, useEffect } from "react";
import { useAtomValue } from "jotai";
import { userState } from "@/state";
import { toast } from "react-hot-toast";
import { ZaloPhoneService } from "../services/zalo-phone.service";
import { saveMemberInfo } from "@/services/sheet.service";
import { authorize, getUserInfo } from "zmp-sdk";

interface MemberData {
  userId: string;
  phone: string;
  registeredAt: string;
  name?: string;
  avatar?: string;
}

export default function MemberInfo() {
  const user = useAtomValue(userState);
  const [loading, setLoading] = useState(false);
  const [memberData, setMemberData] = useState<MemberData | null>(null);

  // Load member data from localStorage on mount
  useEffect(() => {
    const savedData = localStorage.getItem("memberInfo");
    if (savedData) {
      try {
        const data = JSON.parse(savedData);
        setMemberData(data);
      } catch (e) {
        console.error("Failed to parse member data:", e);
      }
    }
  }, []);

  // Handler submit form - lưu vào sheet "Thông tin thành viên"
  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!phone.trim()) {
      toast.error("Vui lòng nhập số điện thoại!");
      return;
    }

    if (!user?.userInfo?.id) {
      toast.error("Không thể lấy thông tin user");
      return;
    }

    setLoading(true);
    try {
      const userId = user.userInfo.id;

      // Lưu trực tiếp vào sheet "Thông tin thành viên"
      const result = await saveMemberInfo(userId, phone);

      console.log("👤 THÀNH VIÊN MỚI ĐĂNG KÝ:");
      console.log("- User ID:", userId);
      console.log("- Số điện thoại:", `'${phone}`);

      // Save to localStorage
      const memberInfo: MemberData = {
        userId,
        phone,
        registeredAt: new Date().toISOString(),
      };
      localStorage.setItem("memberInfo", JSON.stringify(memberInfo));
      setMemberData(memberInfo);

      toast.success("Đã đăng ký thông tin thành viên!");
      setPhone("");
      setShowPopup(false);
    } catch (err: any) {
      console.error("Lỗi đăng ký:", err);
      toast.error("Có lỗi xảy ra, vui lòng thử lại!");
    } finally {
      setLoading(false);
    }
  };

  const handleEditInfo = () => {
    setPhone(memberData?.phone || "");
    setShowPopup(true);
  };

  // Handler ủy quyền Zalo để lấy số điện thoại
  const handleZaloAuthorize = async (openPopupAfter = true) => {
    try {
      setLoading(true);

      // Yêu cầu ủy quyền để lấy số điện thoại
      const result = await authorize({
        scopes: ["scope.userPhonenumber"],
      });

      // Lấy lại user info sau khi authorize
      const updatedUser = await getUserInfo({
        avatarType: "normal",
      });
      
      console.log("🔍 DEBUG - FULL USER OBJECT:");
      console.log("- Full updatedUser:", JSON.stringify(updatedUser, null, 2));
      console.log("- userInfo:", JSON.stringify(updatedUser?.userInfo, null, 2));
      
      if (updatedUser?.userInfo?.id) {
        const userId = updatedUser.userInfo.id;
        const userName = updatedUser.userInfo.name;
        const userAvatar = updatedUser.userInfo.avatar;
        
        // Thử nhiều cách khác nhau để lấy số điện thoại
        const phoneFromZalo = 
          (updatedUser.userInfo as any)?.phone ||
          (updatedUser.userInfo as any)?.phoneNumber ||
          (updatedUser.userInfo as any)?.mobile ||
          (updatedUser as any)?.phone ||
          (updatedUser as any)?.phoneNumber;
          
        console.log("📱 DEBUG - PHONE DETECTION:");
        console.log("- phone:", (updatedUser.userInfo as any)?.phone);
        console.log("- phoneNumber:", (updatedUser.userInfo as any)?.phoneNumber);
        console.log("- mobile:", (updatedUser.userInfo as any)?.mobile);
        console.log("- updatedUser.phone:", (updatedUser as any)?.phone);
        console.log("- Final phoneFromZalo:", phoneFromZalo);
        
        // Thử sử dụng getPhoneNumber API riêng biệt
        let phoneFromAPI: string | null = null;
        try {
          const { getPhoneNumber } = await import('zmp-sdk');
          if (getPhoneNumber) {
            const phoneResult = await getPhoneNumber({});
            console.log("📞 DEBUG - getPhoneNumber result:", phoneResult);
            
            if (phoneResult && phoneResult.token) {
              // Zalo trả về token, nhưng cần backend để decode
              console.log("🔐 DEBUG - Got token from Zalo, but can't decode without backend");
              // Token có nhưng không thể decode ở frontend
              phoneFromAPI = null;
            } else {
              phoneFromAPI = phoneResult?.number || (phoneResult as any)?.phoneNumber;
            }
          }
        } catch (phoneError) {
          console.log("⚠️ getPhoneNumber không khả dụng:", phoneError);
        }
        
        const finalPhone = phoneFromZalo || phoneFromAPI;
        
        if (finalPhone) {
          // Có số điện thoại từ Zalo - tạo memberData ngay
          const newMemberData: MemberData = {
            userId,
            phone: finalPhone,
            registeredAt: new Date().toISOString(),
            name: userName,
            avatar: userAvatar,
          };

          // Lưu vào localStorage và state
          localStorage.setItem("memberInfo", JSON.stringify(newMemberData));
          setMemberData(newMemberData);

          // Lưu vào sheet
          try {
            await saveMemberInfo(userId, finalPhone);
          } catch (sheetError) {
            // Im lặng nếu không lưu được vào sheet
          }

          toast.success(
            `Chào mừng ${userName || "bạn"}! Đã lấy thông tin từ Zalo thành công.`
          );
        } else {
          // Không có số điện thoại - yêu cầu người dùng nhập
          setTempUserData({ userId, userName, userAvatar });
          setShowPhoneInput(true);
          toast.success(
            `Chào mừng ${userName || "bạn"}! Vui lòng nhập số điện thoại để hoàn tất đăng ký.`
          );
        }
      }
    } catch (error) {
      toast.error("Không thể lấy quyền truy cập. Vui lòng nhập thủ công!");
      if (openPopupAfter) {
        setShowPopup(true);
      }
    } finally {
      setLoading(false);
    }
  };

  // Xử lý khi user submit số điện thoại
  const handlePhoneSubmit = async () => {
    if (!phone || phone.length < 10) {
      toast.error("Vui lòng nhập số điện thoại hợp lệ (tối thiểu 10 số)");
      return;
    }

    if (!tempUserData) {
      toast.error("Có lỗi xảy ra, vui lòng thử lại");
      return;
    }

    setLoading(true);
    try {
      const newMemberData: MemberData = {
        userId: tempUserData.userId,
        phone: phone,
        registeredAt: new Date().toISOString(),
        name: tempUserData.userName,
        avatar: tempUserData.userAvatar,
      };

      // Lưu vào localStorage và state
      localStorage.setItem("memberInfo", JSON.stringify(newMemberData));
      setMemberData(newMemberData);

      // Lưu vào sheet
      try {
        await saveMemberInfo(tempUserData.userId, phone);
      } catch (sheetError) {
        // Im lặng nếu không lưu được vào sheet
      }

      // Reset states
      setShowPhoneInput(false);
      setTempUserData(null);
      setPhone("");

      toast.success("Đăng ký thành công! Chào mừng bạn đến với hệ thống thành viên.");
    } catch (error) {
      console.error("Phone submit error:", error);
      toast.error("Có lỗi xảy ra khi lưu thông tin");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="bg-white rounded-lg p-4">
      <h3 className="text-lg font-semibold mb-4 text-center">
        Thông tin thành viên
      </h3>

      {/* Debug tạm thời */}
      <div className="mb-2 p-2 bg-yellow-50 border border-yellow-200 rounded text-xs">
        <div>memberData: {memberData ? "✅ CÓ" : "❌ KHÔNG"}</div>
        {memberData && (
          <>
            <div>Name: {memberData.name || "N/A"}</div>
            <div>Phone: {memberData.phone || "N/A"}</div>
          </>
        )}
        <button
          onClick={() => {
            const stored = localStorage.getItem("memberInfo");
            console.log("🔍 LocalStorage memberInfo:", stored);
            if (stored) {
              try {
                const parsed = JSON.parse(stored);
                console.log("📋 Parsed data:", parsed);
                setMemberData(parsed);
              } catch (e) {
                console.error("Parse error:", e);
              }
            }
          }}
          className="mt-1 px-2 py-1 bg-blue-100 text-blue-800 rounded text-xs mr-2"
        >
          🔄 Reload từ localStorage
        </button>
        <button
          onClick={() => {
            localStorage.removeItem("memberInfo");
            setMemberData(null);
            console.log("🗑️ Cleared memberData");
          }}
          className="mt-1 px-2 py-1 bg-red-100 text-red-800 rounded text-xs"
        >
          🗑️ Clear
        </button>
      </div>

      <div className="space-y-3">
        {/* Hiển thị User ID - bỏ đi */}

        {/* Hiển thị thông tin thành viên hoặc nút đăng ký */}
        {memberData ? (
          <div className="text-center">
            {/* Hiển thị avatar và tên từ Zalo */}
            {memberData.avatar && (
              <img
                src={memberData.avatar}
                alt="Avatar"
                className="w-20 h-20 rounded-full mx-auto mb-3 border-2 border-green-300"
              />
            )}
            {memberData.name && (
              <div className="text-xl font-semibold text-gray-800 mb-2">
                {memberData.name}
              </div>
            )}
            <div className="text-gray-600 mb-2">📱 {memberData.phone}</div>
            <div className="text-sm text-gray-500">
              Thành viên từ{" "}
              {new Date(memberData.registeredAt).toLocaleDateString("vi-VN")}
            </div>
            
            {/* Nút cập nhật nếu chưa có SĐT */}
            {memberData.phone === "Chưa cập nhật" && (
              <button
                onClick={() => setShowPopup(true)}
                className="mt-3 bg-orange-500 text-white py-2 px-4 rounded-lg hover:bg-orange-600 text-sm"
              >
                📝 Cập nhật số điện thoại
              </button>
            )}
          </div>
        ) : (
          <div className="text-center space-y-3">
            {/* Nút ủy quyền Zalo */}
            <button
              onClick={() => handleZaloAuthorize()}
              disabled={loading}
              className="w-full bg-blue-500 text-white py-3 px-4 rounded-lg hover:bg-blue-600 font-medium disabled:opacity-50 flex items-center justify-center space-x-2"
            >
              <span>📱</span>
              <span>{loading ? "Đang xử lý..." : "Lấy SĐT từ Zalo"}</span>
            </button>

            {/* Hoặc nhập thủ công */}
            <div className="text-xs text-gray-500">hoặc</div>

            <button
              onClick={() => setShowPopup(true)}
              className="w-full bg-green-500 text-white py-3 px-4 rounded-lg hover:bg-green-600 font-medium"
            >
              📝 Nhập số điện thoại thủ công
            </button>
            <div className="text-xs text-gray-500 mt-2">
              Đăng ký để nhận ưu đãi và tư vấn
            </div>
          </div>
        )}
      </div>

      {/* Popup nhập số điện thoại */}
      {showPopup && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-lg p-6 w-full max-w-md">
            <div className="flex justify-between items-center mb-4">
              <h4 className="text-lg font-semibold">
                {memberData ? "Cập nhật thông tin" : "Đăng ký thành viên"}
              </h4>
              <button
                onClick={() => {
                  setShowPopup(false);
                  setPhone("");
                }}
                className="text-gray-500 hover:text-gray-700 text-xl"
              >
                ×
              </button>
            </div>

            <form onSubmit={handleSubmit}>
              <div className="mb-4">
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  Số điện thoại của bạn:
                </label>
                <div className="space-y-2">
                  <input
                    type="tel"
                    value={phone}
                    onChange={(e) => setPhone(e.target.value)}
                    placeholder="0987654321"
                    className="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
                    disabled={loading}
                    required
                  />
                  {/* Nút lấy từ Zalo trong popup */}
                  <button
                    type="button"
                    onClick={async () => {
                      await handleZaloAuthorize(false);
                      // Không đóng popup, chỉ cập nhật số điện thoại
                    }}
                    disabled={loading}
                    className="w-full text-sm bg-blue-50 text-blue-600 py-2 px-3 rounded border border-blue-200 hover:bg-blue-100 disabled:opacity-50"
                  >
                    📱 Hoặc lấy từ Zalo
                  </button>
                </div>
              </div>

              <div className="flex space-x-3">
                <button
                  type="button"
                  onClick={() => {
                    setShowPopup(false);
                    setPhone("");
                  }}
                  className="flex-1 bg-gray-300 text-gray-700 py-3 px-4 rounded-lg hover:bg-gray-400"
                  disabled={loading}
                >
                  Hủy
                </button>
                <button
                  type="submit"
                  disabled={loading}
                  className="flex-1 bg-green-500 text-white py-3 px-4 rounded-lg hover:bg-green-600 disabled:opacity-50 font-medium"
                >
                  {loading
                    ? "Đang lưu..."
                    : memberData
                    ? "Cập nhật"
                    : "Đăng ký"}
                </button>
              </div>
            </form>

            <div className="text-xs text-gray-500 mt-3 text-center">
              💡 Số điện thoại sẽ được dùng để liên hệ tư vấn và gửi thông báo
              ưu đãi.
            </div>
          </div>
        </div>
      )}

      {/* Phone Input Modal */}
      {showPhoneInput && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-md">
            <div className="p-6">
              <div className="flex items-center gap-3 mb-6">
                <div className="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                  📱
                </div>
                <div>
                  <h3 className="text-lg font-bold text-gray-800">
                    Nhập số điện thoại
                  </h3>
                  <p className="text-sm text-gray-600">
                    Để hoàn tất đăng ký thành viên
                  </p>
                </div>
              </div>

              <div className="space-y-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">
                    Số điện thoại *
                  </label>
                  <input
                    type="tel"
                    value={phone}
                    onChange={(e) => setPhone(e.target.value.replace(/\D/g, ""))}
                    placeholder="Nhập số điện thoại của bạn"
                    className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                    maxLength={11}
                  />
                </div>

                <div className="flex space-x-3">
                  <button
                    type="button"
                    onClick={() => {
                      setShowPhoneInput(false);
                      setTempUserData(null);
                      setPhone("");
                    }}
                    className="flex-1 bg-gray-300 text-gray-700 py-3 px-4 rounded-lg hover:bg-gray-400"
                    disabled={loading}
                  >
                    Hủy
                  </button>
                  <button
                    type="button"
                    onClick={handlePhoneSubmit}
                    disabled={loading || !phone || phone.length < 10}
                    className="flex-1 bg-green-500 text-white py-3 px-4 rounded-lg hover:bg-green-600 disabled:opacity-50 font-medium"
                  >
                    {loading ? "Đang lưu..." : "Hoàn tất đăng ký"}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
